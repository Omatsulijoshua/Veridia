# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5434/dbname?schema=public"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6381"

# API Configuration
PORT=3000
API_URL="http://localhost:3000"

# Authentication Security Keys
JWT_SECRET="your-jwt-access-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage Settings (AWS S3 or Local Mock)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"

# Payments Config (Paystack, Flutterwave, Stripe)
PAYSTACK_SECRET_KEY="sk_test_..."
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
